{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Antigravity++",
  "version": "0.1.1",
  "identifier": "com.antigravityplusplus.launcher.tauri",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Antigravity++",
        "width": 1080,
        "height": 760,
        "minWidth": 520,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/antigravity-node"
    ],
    "resources": {
      "backend/": "backend/",
      "node-lib/": "node-lib/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    }
  }
}
